 *
 * Device Tree for Samsung Galaxy A52s 5G (SM-A528B / a52sxq)
 */

/dts-v1/;

#include "sm7325-samsung-common.dtsi"

/ {
	model = "Samsung Galaxy A52s 5G";
	compatible = "samsung,a52sxq", "qcom,sm7325", "qcom,sc7280";

	smd: samsung-mobile-device {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		sm5714_charger: sm5714-charger {
			compatible = "samsung,sm5714-charger";
			status = "okay";
		};

		sm5714_fuelgauge: sm5714-fuelgauge {
			compatible = "samsung,sm5714-fuelgauge";
			status = "okay";
			fuelgauge,fuel_alert_soc = <1>;
			fuelgauge,capacity_max = <1000>;
			fuelgauge,capacity_max_margin = <300>;
			fuelgauge,capacity_min = <0>;
			fuelgauge,capacity_calculation_type = <0x1F>;
			fuelgauge,using_temp_compensation;
			fuelgauge,low_temp_limit = <100>;
			fuelgauge,using_hw_vempty;
			fuelgauge,sw_v_empty_voltage = <3200>;
			fuelgauge,sw_v_empty_voltage_cisd = <3100>;
			fuelgauge,sw_v_empty_recover_voltage = <3480>;
			fuelgauge,capacity = <4500>;

			battery_params {
				battery,id = <0>;
				battery0,battery_type = <4430 0x1F20>;
				battery0,battery_table0 = <
					0x1400 0x1B73 0x1C4B 0x1D38 0x1D68 0x1D7A 0x1D88 0x1D8F
					0x1DB4 0x1DEA 0x1E0D 0x1E42 0x1E88 0x1EB4 0x1F01 0x1F3D
					0x1F76 0x1FC7 0x2023 0x207F 0x2116 0x2190 0x2272 0x2400
					>;
				battery0,battery_table1 = <
					0x0000 0x0099 0x0219 0x04B3 0x05CC 0x074C 0x0B80 0x0D19
					0x0FB3 0x14E6 0x1A19 0x1F4C 0x29B3 0x2EE6 0x36B3 0x3BE6
					0x3E80 0x4119 0x464C 0x4B80 0x534C 0x5880 0x6400 0x6419
					>;
				battery0,battery_table2 = <
					0x4B4B 0x4444 0x4040 0x3E3E 0x3C3C 0x3B3B 0x3838 0x3737
					0x3535 0x3434 0x3434 0x3333 0x3333 0x3333 0x3333 0x3232
					>;
				battery0,rs_value = <0x66 0x66 0x3800 0x10A 0x599 0x599 0x70>;
				battery0,v_alarm = <3300 200>;
				battery0,topoff = <650>;
				battery0,i_cal = <1 0x0 0x0800 0x0800 0 0x0 0x0800 0x0830>;
				battery0,v_cal = <1 0x0 0x0 1 0x0 0x0 0x0>;
				battery0,temp_std = <25>;
				battery0,tem_poff = <3400 50 3250 50>;
				battery0,aux_ctrl = <0x322 0x5800>;
				battery0,data_ver = <0x2>;
				battery0,v_max_table = <0x2272 0x2250 0x222E 0x220C 0x21B7>;
				battery0,q_max_table = <0x1F20 0x1E9F 0x1E1E 0x1D9D 0x1C5B>;
			};
		};

		battery: battery {
			compatible = "samsung,sec-battery";
			status = "okay";
			battery,vendor = "Battery";
			battery,technology = <2>;
			battery,chip_vendor = "QCOM";
			battery,batt_data_version = <1>;
			battery,otg_name = "sm5714-otg";
			battery,fuelgauge_name = "sm5714-fuelgauge";
			battery,fgsrc_switch_name = "sm5714-fuelgauge";
			battery,charger_name = "sm5714-charger";
			battery,thermal_source = <2>;
			battery,usb_thermal_source = <4>;
			battery,chg_thermal_source = <2>;
			battery,wpc_thermal_source = <4>;
			battery,polling_time = <10 30 30 30 3600>;
		};
	};
};

&i2c3 {
	status = "okay";

	sm5714: sm5714@49 {
		compatible = "siliconmitus,sm5714mfd";
		reg = <0x49>;
		pinctrl-names = "default";
		pinctrl-0 = <&if_pmic_irq>;
		sm5714,irq-gpio = <&tlmm 54 GPIO_ACTIVE_LOW>;
		sm5714,wakeup;
	};
};

&i2c13 {
	status = "okay";

	touchscreen@49 {
		compatible = "stm,stm_ts";
		reg = <0x49>;
		interrupt-parent = <&tlmm>;
		interrupts = <81 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "on_state", "off_state";
		pinctrl-0 = <&ts_int_active>;
		pinctrl-1 = <&ts_int_suspend>;
		tsp_avdd_ldo-supply = <&vreg_l7c_3p0>;
		tsp_io_ldo-supply = <&vreg_l18b_1p8>;
		sec,irq_gpio = <&tlmm 81 GPIO_ACTIVE_LOW>;
		sec,project_name = "a52sxq", "a52sxq";
		sec,firmware_name = "tsp_stm/fts5cu56a_a52sxq.bin";
		status = "okay";
	};

	touchscreen@62 {
		compatible = "novatek,NVT-ts";
		reg = <0x62>;
		interrupt-parent = <&tlmm>;
		interrupts = <81 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		novatek,irq-gpio = <&tlmm 81 GPIO_ACTIVE_LOW>;
		novatek,reset-gpio = <&tlmm 105 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&mdss_dsi {
	status = "okay";
	vdda-supply = <&vreg_l6b_1p2>;

	panel@0 {
		compatible = "samsung,s6e3fc3-ams646yd01";
		reg = <0>;

		pinctrl-names = "default";
		pinctrl-0 = <&disp_reset_active>, <&disp_te_active>;

		reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
		vddio-supply = <&vreg_l18b_1p8>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&i2c1 {
	status = "okay";

	tas256x: tas256x@4c {
		compatible = "ti,tas2562";
		reg = <0x4c>;
		#sound-dai-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&amp_default>;
		ti,reset-gpio = <&tlmm 63 GPIO_ACTIVE_HIGH>;
		ti,irq-gpio = <&tlmm 55 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

