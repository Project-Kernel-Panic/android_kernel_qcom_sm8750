#
# Configuration fragment for Samsung Galaxy M52 5G (SM-M526B/BR / m52xq)
#

# Platform
CONFIG_ARCH_YUPIK=y
CONFIG_SEC_M52XQ_PROJECT=y
CONFIG_MACH_M52XQ_EUR_OPEN=y

# Input & Touchscreen
CONFIG_INPUT_SEC_INPUT=y
CONFIG_SEC_DEBUG_TSP_LOG=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_INPUT_SEC_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_INPUT_SEC_NOTIFIER=y

# PMIC, Charger & Battery
CONFIG_MFD_SM5714=y
CONFIG_BATTERY_SAMSUNG=y
CONFIG_BATTERY_CISD=y
CONFIG_BATTERY_AGE_FORECAST=y
CONFIG_BATTERY_GKI=y
CONFIG_CHARGER_SM5714=y
CONFIG_FUELGAUGE_SM5714=y

# Display
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC3=y
