#
# Configuration fragment for Samsung Galaxy M52 5G (SM-M526B/BR / m52xq)
#

# Platform
CONFIG_ARCH_YUPIK=y
CONFIG_SEC_M52XQ_PROJECT=y
CONFIG_MACH_M52XQ_EUR_OPEN=y

# Input & Touchscreen
CONFIG_INPUT_SEC_INPUT=y
CONFIG_SEC_DEBUG_TSP_LOG=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_INPUT_SEC_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_INPUT_SEC_NOTIFIER=y
CONFIG_TOUCHSCREEN_STM=y
CONFIG_TOUCHSCREEN_SYNAPTICS=y
CONFIG_TOUCHSCREEN_NT36XXX=y

# PMIC, Charger & Battery
CONFIG_MFD_SM5714=y
CONFIG_BATTERY_SAMSUNG=y
CONFIG_BATTERY_CISD=y
CONFIG_BATTERY_AGE_FORECAST=y
CONFIG_BATTERY_GKI=y
CONFIG_CHARGER_SM5714=y
CONFIG_FUELGAUGE_SM5714=y

# Display
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC3=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HAB=y

# Haptics, Sensors & Audio
CONFIG_SEC_VIBRATOR=y
CONFIG_DC_VIBRATOR=y
CONFIG_INPUT_HALL_IC=y
CONFIG_HALL_NOTIFIER=y
CONFIG_DRV_SAMSUNG=y
CONFIG_SND_SOC_TFA989X=y

# Fingerprint
CONFIG_SENSORS_FINGERPRINT=y
CONFIG_FINGERPRINT_SECURE=y
CONFIG_SENSORS_FINGERPRINT_QCOM=y
CONFIG_SENSORS_ET5XX=y

# SELinux Permissive for Bring-Up
CONFIG_SECURITY_SELINUX_ALWAYS_PERMISSIVE=y
